{
  "name": "enduragent-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Cycling and strength workouts for your intervals.icu calendar, checked before saving and read back after.",
  "homepage": "https://enduragent.icu",
  "bugs": "https://github.com/yerzhansa/enduragent-coach/issues",
  "license": "MIT",
  "author": "Yerzhan Sagyt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yerzhansa/enduragent-coach.git"
  },
  "bin": {
    "enduragent-coach": "dist/server.js"
  },
  "files": [
    "dist/server.js"
  ],
  "type": "module",
  "scripts": {
    "bundle": "tsx tools/bundle.ts",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "types": "tsc -p tsconfig.json",
    "check:code": "tsx tools/check-code-quality.ts",
    "check:trademarks": "tsx tools/check-trademarks.ts",
    "check:privacy": "tsx tools/check-fixture-privacy.ts",
    "check:bundle": "tsx tools/check-bundle.ts",
    "check:plugin": "tsx tools/check-plugin.ts",
    "smoke": "tsx tools/smoke.ts",
    "test": "vitest run",
    "check": "pnpm fmt:check && pnpm lint && pnpm types && pnpm check:code && pnpm check:trademarks && pnpm check:privacy && pnpm test && pnpm check:bundle && pnpm check:plugin && pnpm smoke",
    "hooks:setup": "sh .githooks/setup"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "intervals-icu-api": "0.4.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
